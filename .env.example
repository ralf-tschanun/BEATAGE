# Supabase — SAME project as MyContest (hybrid model C)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Service role key — Polar webhooks only; never expose in browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# BEATAGE public URL (subdomain on gosmooth.eu)
# Local: use 127.0.0.1 (not localhost) so Spotify Connect OAuth accepts the redirect.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
# Production (set in Vercel):
# NEXT_PUBLIC_SITE_URL=https://beatage.gosmooth.eu
# Add these in Supabase → Authentication → URL Configuration → Redirect URLs:
#   http://127.0.0.1:3001/auth/callback
#   http://localhost:3001/auth/callback
#   https://beatage.gosmooth.eu/auth/callback
# Prefer beatage.gosmooth.eu only (no *.vercel.app) so auth never lands on Vercel hosts.

# Polar — separate BEATAGE organization
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_WEBHOOK_SECRET=
# Product IDs from BEATAGE Polar dashboard
POLAR_PRODUCT_PLUS_MONTHLY=
POLAR_PRODUCT_PLUS_YEARLY=
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_YEARLY=
POLAR_PRODUCT_QUIZ_UNLOCK=

# Spotify Web API
# - Client Credentials: track search + release year
# - Authorization Code (Connect): host click-to-play (Premium + open Spotify app)
# Create/reuse an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Spotify Dashboard → Settings → Redirect URIs (exact match, add ALL you use):
#   http://127.0.0.1:3001/api/spotify/callback   ← local only (HTTP + loopback IP; "localhost" is rejected)
#   https://beatage.gosmooth.eu/api/spotify/callback
# Do NOT add *.vercel.app — the app always uses beatage.gosmooth.eu in production.
# Note: Spotify does NOT support wildcards or http://localhost — use 127.0.0.1 for local.
# Open the app at http://127.0.0.1:3001 when testing Connect (same host as SITE_URL).
# Scopes: user-modify-playback-state, user-read-playback-state.

# Last.fm — Live Spotify quizzes (Now Playing via scrobble; no Spotify OAuth)
# Create an API account at https://www.last.fm/api/account/create
# Hosts link Spotify → Last.fm in the Spotify app, then enter their Last.fm username.
LASTFM_API_KEY=
# LASTFM_SHARED_SECRET=  # only needed if we add Last.fm OAuth later

# Optional: protect /api/cron/purge-expired-quizzes (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
