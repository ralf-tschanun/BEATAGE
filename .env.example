# Supabase — SAME project as MyContest (hybrid model C)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Service role key — Polar webhooks only; never expose in browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# BEATAGE public URL (subdomain on gosmooth.eu)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Add these in Supabase → Authentication → URL Configuration → Redirect URLs:
#   http://localhost:3001/auth/callback
#   https://beatage.gosmooth.eu/auth/callback
#   https://beatage-*.vercel.app/auth/callback  (preview deployments)

# Polar — separate BEATAGE organization
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_WEBHOOK_SECRET=
# Product IDs from BEATAGE Polar dashboard
POLAR_PRODUCT_PLUS_MONTHLY=
POLAR_PRODUCT_PLUS_YEARLY=
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_YEARLY=
POLAR_PRODUCT_QUIZ_UNLOCK=

# Spotify Web API (Client Credentials) — track search + release year lookup
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
